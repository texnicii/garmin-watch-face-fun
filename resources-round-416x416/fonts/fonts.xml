<fonts xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <!-- JetBrains Mono bitmap fonts (Latin + Cyrillic), generated by
         tools/fonts/gen_fonts.py: NeonTime = Light clock digits; NeonDate =
         Medium date; NeonCap = Medium curve captions; NeonVal = Medium
         percent values. Sizes are per resolution bucket; the base copy
         (454) also serves the venux1 rectangle. -->
    <font id="NeonTime" filename="NeonTime.fnt" antialias="true" />
    <font id="NeonDate" filename="NeonDate.fnt" antialias="true" />
    <font id="NeonCap" filename="NeonCap.fnt" antialias="true" />
    <font id="NeonVal" filename="NeonVal.fnt" antialias="true" />
</fonts>
