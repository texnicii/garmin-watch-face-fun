<strings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <!-- Russian (rus) locale bundle.

         The in-face strings carry IDENTICAL values to resources/strings/ on
         purpose: the plain ids are always English and the *Ru ids are always
         Russian, on ANY device locale, so the in-app Language setting can force
         either language. They are mirrored here (rather than left to fall back)
         only to satisfy the compiler's "every id translated for declared
         language" check and keep the build warning-free.

         Only the settings-UI labels genuinely differ by locale (the app name
         is "Fun Bra" in both). -->

    <string id="AppName">Fun Bra</string>

    <!-- Curve captions (UPPERCASE — drawn with the NeonCap subset) -->
    <string id="capSteps">STEPS</string>
    <string id="capActive">ACTIVE</string>
    <string id="capBattery">BATTERY</string>
    <string id="capStepsRu">ШАГИ</string>
    <string id="capActiveRu">АКТИВН.</string>
    <string id="capBatteryRu">ЗАРЯД</string>

    <!-- Weekday names (1=Sun..7=Sat, so dow0=Sunday). UPPERCASE — NeonDate subset. -->
